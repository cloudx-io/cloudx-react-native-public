# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# ---------------------------------------------------------------------------
# Architecture toggle (OldArch = Paper, NewArch = Fabric + TurboModules).
# Set RCT_NEW_ARCH_ENABLED=1 before `pod install` to build the NewArch
# variant. Unset / 0 defaults to OldArch for the existing publisher
# compatibility surface.
# ---------------------------------------------------------------------------
new_arch_enabled = (ENV['RCT_NEW_ARCH_ENABLED'] == '1')
puts "[CloudXRN Podfile] new_arch_enabled=#{new_arch_enabled}"

target 'CloudXReactNativeDemo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => new_arch_enabled
  )

  # Google Mobile Ads, for the GAM fallback leg. Pulled in by
  # react-native-google-mobile-ads via use_native_modules! above — it is NOT
  # declared here explicitly, and CloudXGoogleWaterfallAdapter is deliberately
  # absent.
  #
  # Two reasons the Google Waterfall adapter must stay out of this app:
  #   1. Semantics. Google Waterfall runs AdMob demand *inside* the CloudX
  #      auction. First Look is the opposite: GAM is the publisher's own
  #      separate stack that CloudX never sees. Including it would make this
  #      demo measure something other than what it claims to.
  #   2. Mechanics. The adapter pins Google-Mobile-Ads-SDK to an exact version,
  #      and react-native-google-mobile-ads brings its own. CocoaPods resolves
  #      one version per pod for the whole project, so the two fight.

  # CloudXCore comes from the cloudx-react-native podspec, so only the adapters
  # are declared here. Each one is declared by major version (`~> 6.0` means
  # `>= 6.0, < 7.0`) and resolves to the newest release on that line, so the
  # demo does not go stale between releases. Podfile.lock is not committed for
  # the same reason. Adapters version independently of CloudXCore, on the
  # network SDK's line.
  pod 'CloudXMetaAdapter',           '~> 6.0'
  pod 'CloudXVungleAdapter',         '~> 7.0'
  pod 'CloudXInMobiAdapter',         '~> 11.0'
  pod 'CloudXMintegralAdapter',      '~> 8.0'
  pod 'CloudXUnityAdsAdapter',       '~> 4.0'
  pod 'CloudXMagniteAdapterV2',      '~> 1.0'
  pod 'CloudXMolocoAdapter',         '~> 4.0'
  pod 'CloudXVerveAdapter',          '~> 3.0'
  pod 'CloudXDigitalTurbineAdapter', '~> 8.0'
  pod 'CloudXPangleAdapter',         '~> 8.0'
  pod 'CloudXMobileFuseAdapter',     '~> 1.0'
  pod 'CloudXTaurusXAdapter',        '~> 1.0'
  pod 'CloudXBigoAdapter',           '~> 6.0'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Xcode 26 enables explicit modules, which breaks this CocoaPods + React Native
    # workspace with non-modular include failures across generated pod modules.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_WARN_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'NO'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        build_config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
          build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end
      end

      aggregate_target.user_project.save
    end
  end
end
