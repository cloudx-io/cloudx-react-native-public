<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Cleartext HTTP is needed only so a debug build can reach the Metro dev
      server on localhost. Keeping it in the debug manifest means release
      builds ship with cleartext disabled.
    -->
    <application
      android:usesCleartextTraffic="true"
      tools:targetApi="28"
      tools:ignore="GoogleAppIndexingWarning" />
</manifest>
